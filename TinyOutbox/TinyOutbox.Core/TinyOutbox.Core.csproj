<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet Paketleme Ayarları -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<!-- NuGet Metadata -->
		<PackageId>TinyOutbox.Core</PackageId>
		<Version>1.0.0</Version>
		<Authors>Mustafa</Authors>
		<Description>Core contracts, interfaces and abstractions for TinyOutbox Transactional Outbox and Inbox patterns.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/mustafaa428/TinyOutbox</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mustafaa428/TinyOutbox</RepositoryUrl>
		<PackageTags>outbox;inbox;transactional-outbox;messaging;microservices;event-driven</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	  <Folder Include="Services\Concrate\" />
	</ItemGroup>

</Project>