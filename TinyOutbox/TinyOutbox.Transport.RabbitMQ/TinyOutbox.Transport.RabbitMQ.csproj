<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet Paketleme Ayarları -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<!-- NuGet Metadata -->
		<PackageId>TinyOutbox.Transport.RabbitMQ</PackageId>
		<Version>1.0.0</Version>
		<Authors>Mustafa</Authors>
		<Description>Lightweight RabbitMQ message publisher transport for TinyOutbox.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/mustafaa428/TinyOutbox</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mustafaa428/TinyOutbox</RepositoryUrl>
		<PackageTags>outbox;rabbitmq;transport;messaging</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
		<PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TinyOutbox.Core\TinyOutbox.Core.csproj" />
		<ProjectReference Include="..\TinyOutbox.Hosting\TinyOutbox.Hosting.csproj" />
	</ItemGroup>

</Project>